# Copy to dev/.env and edit. dev/.env is gitignored.
#
#   cp dev/.env.example dev/.env

# --- The database -----------------------------------------------------------

# Required. Any value; this database is not reachable from outside the compose
# network, but the stack refuses to start without one rather than shipping a
# default password that somebody eventually deploys.
POSTGRES_PASSWORD=change-me

POSTGRES_USER=mmuser
POSTGRES_DB=mattermost

# --- The server -------------------------------------------------------------

# Where the server is reachable *from a browser*. Get this wrong and everything
# works until the last step of connecting a calendar.
#
# Yandex sends the person's browser back to
#     <MM_SITE_URL>/plugins/yandex-calendar/oauth/complete
# and refuses to do so unless that exact string is registered as a redirect URI
# on the Yandex application. So this has to be what you will type into a
# browser, and what you registered at oauth.yandex.ru — not "localhost" when
# the server is on another machine.
#
# Running the server on another host: use that host's name or address, e.g.
#     MM_SITE_URL=http://dev-box.lan:8065
MM_SITE_URL=http://localhost:8065

MATTERMOST_PORT=8065
MATTERMOST_VERSION=11.11.1

# DEBUG while developing: the plugin logs what it skipped and why, and none of
# that is ever shown to a user.
MM_LOG_LEVEL=DEBUG

# --- Deploying the plugin ---------------------------------------------------
# Used by `make deploy` (dev/deploy.sh). It talks to the server over HTTP, so
# the server can be this machine or another one.

# Where `make deploy` sends the bundle. Usually the same as MM_SITE_URL.
MM_SERVER_URL=http://localhost:8065

# Either a personal access token, or an admin username and password. The token
# wins if both are set.
#MM_ADMIN_TOKEN=
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=change-me-too

# --- The Yandex application -------------------------------------------------
# Not read by anything here. They go in the System Console, under
# Plugins -> Yandex Calendar, and are noted so that one file holds everything
# this server needs. See docs/admin-setup.md for how to get them.
#
#YANDEX_CLIENT_ID=
#YANDEX_CLIENT_SECRET=
