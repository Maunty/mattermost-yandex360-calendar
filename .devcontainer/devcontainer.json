{
	"name": "Yandex Calendar for Mattermost",

	// Two files: the server stack, then the workspace container that joins it.
	// dev/compose.yml comes first, which makes dev/ the compose project
	// directory — so dev/.env is picked up automatically, and relative paths
	// in both files resolve against dev/.
	"dockerComposeFile": [
		"../dev/compose.yml",
		"docker-compose.yml"
	],
	"service": "app",
	"workspaceFolder": "/workspaces/mattermost-ya-calendar",

	// Everything, so that opening the repo gives a server to deploy into
	// rather than a toolchain and a to-do list.
	"runServices": [
		"app",
		"postgres",
		"mattermost"
	],
	"shutdownAction": "stopCompose",

	// Mattermost, forwarded to your browser.
	//
	// Whatever address you end up reaching it at is what MM_SITE_URL has to
	// be, and what you register at Yandex as the redirect URI — because
	// connecting a calendar finishes by Yandex telling *your browser* to go
	// there. Yandex itself never connects to it, so the server does not have
	// to be reachable from the internet, only from the browser you consent in.
	//
	// VS Code forwards from the mattermost service itself, and it is the only
	// thing that binds 8065: the compose override stops Docker publishing the
	// same port, which is what made a restart race the old forward for it.
	// requireLocalPort refuses to fall back to another port silently, because
	// the Yandex redirect would still point at 8065.
	"forwardPorts": [
		"mattermost:8065"
	],
	"portsAttributes": {
		"8065": {
			"label": "Mattermost",
			"onAutoForward": "notify",
			"requireLocalPort": true
		}
	},

	"containerEnv": {
		// Load-bearing rather than incidental: go.mod pins a patch release,
		// and this is what goes and gets it.
		"GOTOOLCHAIN": "auto"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go"
			],
			"settings": {
				// `make check` fails on anything `gofmt -l .` prints, so the
				// editor has to format with gofmt and nothing else. Letting it
				// default to goimports or gofumpt would mean saving a file
				// could break the build.
				"go.formatTool": "gofmt",
				"go.vetOnSave": "package",
				"go.lintOnSave": "off",

				// The suite asserts on behaviour through a fake calendar
				// server, so a cached pass is not evidence of anything. This
				// is the flag the Makefile uses.
				"go.testFlags": [
					"-count=1"
				],
				"go.testTimeout": "120s",
				"go.toolsManagement.autoUpdate": false,

				"[go]": {
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				},
				"gopls": {
					"ui.semanticTokens": true
				}
			}
		}
	},

	// Warms the module cache so the first `make test` is not also the first
	// download. Deliberately not `go build ./...`: a slow way to learn nothing
	// the test run will not tell you.
	"postCreateCommand": "go mod download",

	"remoteUser": "vscode"
}
