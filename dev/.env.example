# Optional. Everything here has a working default, which is what lets the dev
# container bring the whole stack up before anyone has written a file. Copy it
# when you want to change something:
#
#   cp dev/.env.example dev/.env
#
# Docker Compose reads dev/.env by itself, because dev/ is the compose project
# directory. The deploy and bootstrap scripts read it too — but never over the
# top of a variable already set in the environment, so the dev container's own
# settings win inside it.

# --- The one worth setting ---------------------------------------------------

# Where the server is reachable *from a browser*. Get this wrong and everything
# works until the last step of connecting a calendar.
#
# Yandex sends the person's browser back to
#     <MM_SITE_URL>/plugins/yandex-calendar/oauth/complete
# only if that exact string is registered as a redirect URI on the Yandex
# application. Otherwise it sends the browser to the first one registered. So
# this has to be what you will type into a browser, and what you registered at
# oauth.yandex.ru.
#
# On a remote dev box, that is the box, not localhost:
#     MM_SITE_URL=http://dev-box.lan:8065
MM_SITE_URL=http://localhost:8065

# If you change the port in MM_SITE_URL, change this to match: it is the port
# published on the host, and the two have to agree.
MATTERMOST_PORT=8065

# --- The server --------------------------------------------------------------

MATTERMOST_VERSION=11.11.1

# DEBUG while developing. The plugin logs what it skipped and why, and none of
# that is ever shown to a user, so the log is the only place it exists.
MM_LOG_LEVEL=DEBUG

# --- The database ------------------------------------------------------------
# Reachable only from inside the compose network. Worth changing if the machine
# is shared, though what actually keeps this stack safe is not exposing it.

POSTGRES_PASSWORD=mattermost-dev
POSTGRES_USER=mmuser
POSTGRES_DB=mattermost

# --- The admin account -------------------------------------------------------
# `make dev-admin` creates this one. The first account on a Mattermost server is
# made a system admin, which is how it gets its privileges.

MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=DevAdmin123!
#MM_ADMIN_EMAIL=admin@example.com
#MM_TEAM_NAME=dev

# --- Where deploys go --------------------------------------------------------

# Where `make deploy` and `make dev-admin` reach the server. Not the same idea
# as MM_SITE_URL: that one is for browsers, this one is for these scripts.
#
# Leave it commented out. From the host it defaults to localhost, and inside
# the dev container it is already set to the service name on the compose
# network, which setting it here would not override but would make confusing.
# Set it only to deploy to a server somewhere else:
#     MM_SERVER_URL=http://dev-box.lan:8065
#MM_SERVER_URL=

# A personal access token instead of the username and password above, if you
# would rather. It wins if both are set.
#MM_ADMIN_TOKEN=

# --- The Yandex application --------------------------------------------------
# Not read by anything here. They go in the System Console, under
# Plugins -> Yandex Calendar, and are noted so one file holds everything this
# server needs. docs/admin-setup.md says where they come from.
#
#YANDEX_CLIENT_ID=
#YANDEX_CLIENT_SECRET=
